{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "STALKER 2 CFG",
  "scopeName": "source.stalker2cfg",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#structHeaders"
    },
    {
      "include": "#metadata"
    },
    {
      "include": "#arrayIndices"
    },
    {
      "include": "#enums"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#propertyKeys"
    },
    {
      "include": "#specialValues"
    },
    {
      "include": "#structKeywords"
    },
    {
      "include": "#sidValues"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.stalker2cfg",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.stalker2cfg",
          "begin": "'",
          "end": "'"
        },
        {
          "name": "string.quoted.double.stalker2cfg",
          "begin": "\"",
          "end": "\""
        }
      ]
    },
    "structHeaders": {
      "patterns": [
        {
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*(struct\\.begin)\\b",
          "captures": {
            "1": {
              "name": "entity.name.type.prototype.stalker2cfg"
            },
            "2": {
              "name": "punctuation.separator.key-value.stalker2cfg"
            },
            "3": {
              "name": "keyword.control.struct.stalker2cfg"
            }
          }
        }
      ]
    },
    "metadata": {
      "patterns": [
        {
          "match": "\\b(refurl)\\s*(=)\\s*([^;,}]+)",
          "captures": {
            "1": {
              "name": "support.type.property-name.stalker2cfg"
            },
            "2": {
              "name": "keyword.operator.assignment.stalker2cfg"
            },
            "3": {
              "name": "string.unquoted.path.stalker2cfg"
            }
          }
        },
        {
          "match": "\\b(refkey)\\s*(=)\\s*([^;,}]+)",
          "captures": {
            "1": {
              "name": "support.type.property-name.stalker2cfg"
            },
            "2": {
              "name": "keyword.operator.assignment.stalker2cfg"
            },
            "3": {
              "name": "variable.other.reference.stalker2cfg"
            }
          }
        },
        {
          "match": "\\{\\s*(bpatch|bdelete|bskipref)\\s*\\}",
          "captures": {
            "1": {
              "name": "storage.modifier.patch.stalker2cfg"
            }
          }
        }
      ]
    },
    "arrayIndices": {
      "patterns": [
        {
          "name": "constant.numeric.array-index.stalker2cfg",
          "match": "\\[(?:\\d+|\\*)\\]"
        }
      ]
    },
    "enums": {
      "patterns": [
        {
          "name": "constant.other.enum.stalker2cfg",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*::[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.stalker2cfg",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.stalker2cfg",
          "match": "(?<![A-Za-z0-9_])[-+]?\\d+(?:\\.\\d+)?%?"
        }
      ]
    },
    "propertyKeys": {
      "patterns": [
        {
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
          "captures": {
            "1": {
              "name": "variable.other.property.stalker2cfg"
            },
            "2": {
              "name": "keyword.operator.assignment.stalker2cfg"
            }
          }
        }
      ]
    },
    "specialValues": {
      "patterns": [
        {
          "name": "constant.language.empty.stalker2cfg",
          "match": "\\b(?:empty|None|null)\\b"
        },
        {
          "name": "keyword.operator.assignment.stalker2cfg",
          "match": "(?<!:)=(?!=)"
        }
      ]
    },
    "structKeywords": {
      "patterns": [
        {
          "name": "keyword.control.struct.stalker2cfg",
          "match": "\\bstruct\\.(?:begin|end)\\b"
        },
        {
          "name": "storage.modifier.patch.stalker2cfg",
          "match": "\\b(?:bpatch|bdelete|bskipref)\\b"
        }
      ]
    },
    "sidValues": {
      "patterns": [
        {
          "match": "(?<==\\s)([A-Za-z_][A-Za-z0-9_]*(?:_[A-Za-z0-9_]+)*)\\s*$",
          "captures": {
            "1": {
              "name": "variable.other.sid.stalker2cfg"
            }
          }
        }
      ]
    }
  }
}
