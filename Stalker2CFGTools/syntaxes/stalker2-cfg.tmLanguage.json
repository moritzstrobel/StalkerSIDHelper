{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "STALKER 2 CFG",
  "scopeName": "source.stalker2cfg",
  "patterns": [
    { "include": "#comments" },
    { "include": "#structHeaders" },
    { "include": "#strings" },
    { "include": "#booleans" },
    { "include": "#numbers" },
    { "include": "#enumValues" },
    { "include": "#propertyKeys" },
    { "include": "#sids" },
    { "include": "#structKeywords" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.stalker2cfg", "match": "//.*$" }
      ]
    },
    "structHeaders": {
      "patterns": [
        {
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*(struct\\.begin)\\b",
          "captures": {
            "1": { "name": "entity.name.type.prototype.stalker2cfg" },
            "2": { "name": "punctuation.separator.key-value.stalker2cfg" },
            "3": { "name": "keyword.control.struct.stalker2cfg" }
          }
        },
        {
          "match": "\\b(refkey|refurl)\\s*(=)\\s*([^,}]+)",
          "captures": {
            "1": { "name": "support.type.property-name.stalker2cfg" },
            "2": { "name": "keyword.operator.assignment.stalker2cfg" },
            "3": { "name": "variable.other.reference.stalker2cfg" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.single.stalker2cfg", "begin": "'", "end": "'" },
        { "name": "string.quoted.double.stalker2cfg", "begin": "\"", "end": "\"" }
      ]
    },
    "booleans": {
      "patterns": [
        { "name": "constant.language.boolean.stalker2cfg", "match": "\\b(true|false)\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.stalker2cfg", "match": "(?<![A-Za-z0-9_])[-+]?\\d+(?:\\.\\d+)?%?" }
      ]
    },
    "enumValues": {
      "patterns": [
        { "name": "constant.other.enum.stalker2cfg", "match": "\\b[A-Za-z_][A-Za-z0-9_]*::[A-Za-z_][A-Za-z0-9_]*\\b" }
      ]
    },
    "propertyKeys": {
      "patterns": [
        {
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*|\\[(?:\\d+|\\*)\\])\\s*(=)",
          "captures": {
            "1": { "name": "variable.other.property.stalker2cfg" },
            "2": { "name": "keyword.operator.assignment.stalker2cfg" }
          }
        }
      ]
    },
    "sids": {
      "patterns": [
        { "name": "variable.other.sid.stalker2cfg", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?:SID|Effect|Template|Prototype|Processor|Value|Socket|Slot|Weapon|Attach|Upgrade)[A-Za-z0-9_]*\\b" }
      ]
    },
    "structKeywords": {
      "patterns": [
        { "name": "keyword.control.struct.stalker2cfg", "match": "\\bstruct\\.(?:begin|end)\\b" },
        { "name": "storage.modifier.patch.stalker2cfg", "match": "\\b(?:bpatch|bdelete)\\b" }
      ]
    }
  }
}
